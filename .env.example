# Web3Forms Access Key for contact form submissions
# Get your free key instantly at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Supabase Database & Auth Configuration
# Get these from your Supabase Project Settings > API (https://supabase.com/dashboard)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Admin Authorization Whitelist
# Comma-separated list of Google OAuth or Supabase Auth emails permitted to manage data
VITE_ADMIN_EMAILS=vivazprince@gmail.com,your.email@example.com
